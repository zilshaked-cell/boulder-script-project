{
  "customStatusBar.buttonConfig": [
    {
      "type": "button",
      "name": "clasp push",
      "icon": "cloud-upload",
      "command_terminal": "cd \"$workspace\" && clasp push",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Run Dev",
      "icon": "play",
      "command_terminal": "cd \"$workspace/../boulder-shifts-app\" && npm run dev",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Git Status",
      "icon": "git-branch",
      "command_terminal": "cd \"$workspace\" && git status -sb",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Git Pull (ff-only)",
      "icon": "cloud-download",
      "command_terminal": "cd \"$workspace\" && git pull --ff-only",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Lint Web",
      "icon": "check",
      "command_terminal": "cd \"$workspace/../boulder-shifts-app\" && npm run lint",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Build Web",
      "icon": "gear",
      "command_terminal": "cd \"$workspace/../boulder-shifts-app\" && npm run build",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Commit+Push App",
      "icon": "git-commit",
      "command_terminal": "cd \"$workspace/../boulder-shifts-app\" && npm run build && git add -A && git commit -m \"$(Get-Date -Format 'yyyy-MM-dd HH:mm') - app\" && git push",
      "when": ".*"
    },
    {
      "type": "button",
      "name": "Commit+Push Script",
      "icon": "git-commit",
      "command_terminal": "cd \"$workspace\" && git add -A && git commit -m \"$(Get-Date -Format 'yyyy-MM-dd HH:mm') - script\" && git push && clasp push",
      "when": ".*"
    }
  ],
  "customStatusBar.showOnStartup": true,
  "github.copilot.enable": {
    "*": true,
    "markdown": false,
    "plaintext": false
  },
  "github.copilot.inlineSuggest.enable": true,
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "always",
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.codeGeneration.instructionsFiles": [
    ".github/copilot-instructions.md"
  ],
  "github.copilot.chat.promptFiles": [
    ".github/prompts"
  ],
  "github.copilot.chat.agents.customAgents": [
    ".github/agents"
  ],
  "github.copilot.chat.checkpoints.enabled": true,
  "github.copilot.chat.checkpoints.showFileChanges": true,
  "github.copilot.chat.tools.execution.allowCommands": false,
  "github.copilot.chat.tools.execution.allowGlobalTools": false,
  "eslint.packageManager": "npm",
  "eslint.workingDirectories": [
    {
      "directory": ".",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [
    "javascript"
  ],
  "eslint.alwaysShowStatus": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "taskButtons.buttons": [
    {
      "task": "script: clasp pull",
      "buttonLabel": "clasp pull"
    },
    {
      "task": "script: clasp sync (status+push)",
      "buttonLabel": "clasp sync"
    }
  ]
}
